{
  "github-devops-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "~/gemini_py3_env/bin/python ./hooks/devops_guard.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
